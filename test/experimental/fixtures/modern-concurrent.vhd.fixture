entity modern_concurrent is
    port (selector : in bit; payload : in bit_vector(1 downto 0); result : out bit_vector(1 downto 0));
end entity;

architecture rtl of modern_concurrent is
begin
    branches: if first: true generate
        observe: process (all) is
            variable sample : bit;
        begin
            sample := payload(0);
        end process;
    else second: generate
        assert true severity note;
    end generate;
    choices: case 0 generate
        when empty: 0 =>
            postponed assert payload'length = 2;
        when remaining: others =>
            with selector select ?
                result <= payload when '0', (others => '0') when others;
    end generate;
end architecture;
