entity sequential_2008 is
end entity;

architecture rtl of sequential_2008 is
  signal s : boolean;
begin
  p : process is
    variable x : boolean := false;
  begin
    x := true when s else false;
    with s select x := true when true, false when others;
    s <= true when x else false after 1 ns;
    with x select s <= true after 1 ns, false after 2 ns when true, unaffected when others;
    s <= force in true;
    s <= release in;
    s <= force out true when x else false;
    with x select s <= force out true when true, false when others;
    wait;
  end process p;
end architecture;
