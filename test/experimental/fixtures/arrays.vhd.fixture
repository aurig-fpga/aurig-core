package composite_arrays is
    subtype idx is natural range 1 to 3;
    constant pattern : bit_vector(0 to 3) := "0101";
    type lane is array (idx) of bit;
    type explicit_index is array (std.standard.natural range 0 to 3) of bit;
    type \Lanes, of;\ is array
        (idx, pattern'reverse_range(1), (2 + 4) downto 3)
        of std.standard.bit;
    type bitmap is array (natural range <>) of std.standard.bit;
    type matrix is array (std.standard.natural range <>, idx range <>) of lane;
    type vector_array is array (0 to 1) of bit_vector(7 downto 0);
    type char_index is array ('(' to ')') of bit; -- end record; array (,
end package;

package body composite_arrays is
    type package_body_array is array (idx) of bit;
    procedure use_array is
        type procedure_array is array (0 to 3) of bit;
    begin
        null;
    end procedure;
end package body;

entity array_entity is
    type entity_array is array (0 to 3) of bit;
end;
architecture rtl of array_entity is
    type arch_array is array (0 to 3) of bit;
begin
    p : process is
        type process_array is array (0 to 3) of bit;
    begin
        wait;
    end process;
end;
