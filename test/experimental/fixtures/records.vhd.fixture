package composite_records is
    type vector_a is array (0 to 3) of bit;
    type \Packet, record;\ is record
        left_field, -- these keywords are comments: end record;
        \RIGHT; FIELD\ : std.standard.bit;
        content : vector_a;
        tag : std.standard.integer range -2 to 2;
        punctuation : character range '(' to ')';
    end record \Packet, record;\;
    type wrapped is record child : \Packet, record;\; last_field : bit; end record WRAPPED;
    type packet_array is array (0 to 7) of wrapped;
end;

package body composite_records is
    type inside_body is record x : vector_a; end record;
    function f return bit is
        type local_record is record local : vector_a; end record;
    begin
        return '0';
    end function;
end;

entity record_entity is
    type entity_record is record data : bit; end record;
end;
architecture rtl of record_entity is
    type arch_record is record a : bit; end record;
begin
    p : process is
        type process_record is record data : bit; end record;
    begin
        wait;
    end process;
end;
